    {
      "id": "U39-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生法第32條第1項規定，雇主對勞工應施以從事工作與預防災變所必要之何種教育及訓練？",
      "options": [
        {
          "id": "A",
          "text": "安全衛生教育及訓練"
        },
        {
          "id": "B",
          "text": "語文教育及訓練"
        },
        {
          "id": "C",
          "text": "電腦技能教育及訓練"
        },
        {
          "id": "D",
          "text": "行銷技能教育及訓練"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "職安法第32條第1項明定，雇主對勞工應施以從事工作與預防災變所必要之「安全衛生教育及訓練」。此為雇主之法定義務，也是勞工敬業精神之基礎——具備安全衛生知能方能安全地完成工作。",
      "references": [
        {
          "title": "職業安全衛生法第32條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060001&flno=32"
        }
      ]
    },
    {
      "id": "U39-Q002",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生法第32條第3項規定，勞工對於安全衛生教育及訓練，有何義務？",
      "options": [
        {
          "id": "A",
          "text": "有接受之義務"
        },
        {
          "id": "B",
          "text": "可自由選擇是否接受"
