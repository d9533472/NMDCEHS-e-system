    {
      "id": "U07-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "《危險性工作場所審查及檢查辦法》的法律授權依據為何？",
      "options": [
        {
          "id": "A",
          "text": "職業安全衛生法第二十三條第四項"
        },
        {
          "id": "B",
          "text": "勞動檢查法第二十六條第二項"
        },
        {
          "id": "C",
          "text": "勞動基準法第二十三條"
        },
        {
          "id": "D",
          "text": "職業安全衛生法第六條第三項"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "危險性工作場所審查及檢查辦法第1條明定，本辦法依勞動檢查法第二十六條第二項規定訂定之。A選項是職業安全衛生管理辦法的授權依據；C選項與本辦法無關；D選項是職業安全衛生設施規則等法規的授權依據。",
      "references": [
        {
          "title": "危險性工作場所審查及檢查辦法第1條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0070019&flno=1"
        }
      ]
    },
