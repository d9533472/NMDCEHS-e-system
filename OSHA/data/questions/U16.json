  "questions": [
    {
      "id": "U16-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "工作安全分析（Job Safety Analysis, JSA）的首要步驟是什麼？",
      "options": [
        {
          "id": "A",
          "text": "辨識危害因素"
        },
        {
          "id": "B",
          "text": "將工作分解為若干步驟"
        },
        {
          "id": "C",
          "text": "訂定安全作業標準"
        },
        {
          "id": "D",
          "text": "實施安全觀察"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "JSA的第一步是將工作分解為若干步驟，藉由逐步拆解作業流程，才能系統性地辨識每個步驟中潛在的危害。先分解步驟、再辨識危害、進而訂定對策，是JSA的標準流程。",
      "references": [
        {
          "title": "職業安全衛生法施行細則第31條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060002&flno=31"
        }
      ]
    },
    {
      "id": "U16-Q002",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "工作安全分析中，將工作分解為步驟後，接下來的步驟是什麼？",
      "options": [
        {
          "id": "A",
          "text": "實施安全觀察"
        },
        {
          "id": "B",
          "text": "辨識各步驟的潛在危害"
        },
        {
          "id": "C",
          "text": "撰寫工作守則"
        },
        {
          "id": "D",
          "text": "辦理教育訓練"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "JSA的流程為：1.選定工作→2.將工作分解為步驟→3.辨識各步驟的潛在危害→4.訂定安全措施→5.依據分析結果訂定安全作業標準。分解步驟後即進行危害辨識。",
      "references": [
        {
          "title": "職業安全衛生法施行細則第31條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060002&flno=31"
        }
      ]
    },
    {
      "id": "U16-Q003",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依《職業安全衛生法施行細則》第31條規定，職業安全衛生管理計畫應包括之事項中，何者與工作安全分析直接相關？",
      "options": [
