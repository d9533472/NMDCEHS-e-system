    {
      "id": "U16-Q006",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "安全觀察主要的目的為何？",
      "options": [
        {
          "id": "A",
          "text": "處罰違規勞工"
        },
        {
          "id": "B",
          "text": "發現不安全行為及不安全狀況並加以改善"
        },
        {
          "id": "C",
          "text": "考核勞工之工作效率"
        },
        {
          "id": "D",
          "text": "記錄生產數據"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "安全觀察之目的在於主動發現作業場所中之不安全行為（人的不安全動作）及不安全狀況（物與環境的不安全狀態），進一步分析原因並加以改善，以預防職業災害之發生，非為處罰或考核效率。",
      "references": [
        {
          "title": "職業安全衛生法施行細則第31條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060002&flno=31"
        }
      ]
