  "questions": [
    {
      "id": "U30-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生設施規則第152條規定，雇主對於物料之堆放，應依下列何者辦理？",
      "options": [
        {
          "id": "A",
          "text": "應清除通道上阻礙物，保持通暢"
        },
        {
          "id": "B",
          "text": "可任意堆放於通道上"
        },
        {
          "id": "C",
          "text": "不需考慮通道通暢"
        },
        {
          "id": "D",
          "text": "僅需在緊急時清除通道"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "職業安全衛生設施規則第152條規定，雇主對於物料之堆放，應清除通道上之阻礙物，保持通道通暢。B、C、D均不符規定，通道須隨時保持通暢以確保安全。",
      "references": [
        {
          "title": "職業安全衛生設施規則第152條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060009&flno=152"
        }
      ]
    },
    {
      "id": "U30-Q002",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依職業安全衛生設施規則第153條規定，雇主為防止物料倒塌，應採取哪些措施？",
      "options": [
