{
  "unitId": "U34",
  "unitTitle": "物理性危害預防",
  "unitNumber": 34,
  "questions": [
    {
      "id": "U34-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生設施規則，勞工工作場所因機械設備所發生之聲音超過多少分貝時，雇主應採取工程控制、減少勞工噪音暴露時間等措施？",
      "options": [
        {
          "id": "A",
          "text": "80分貝"
        },
        {
          "id": "B",
          "text": "85分貝"
        },
        {
          "id": "C",
          "text": "90分貝"
        },
        {
          "id": "D",
          "text": "100分貝"
        }
      ],
      "answer": [
        "C"
      ],
      "explanation": "職業安全衛生設施規則規定，勞工工作場所因機械設備所發生之聲音超過90分貝時，雇主應採取工程控制、減少勞工噪音暴露時間等措施，使勞工噪音暴露工作日八小時日時量平均不超過規定值或相當之劑量值。90分貝為實施噪音管制措施之基準。",
      "references": [
        {
          "title": "職業安全衛生設施規則第300條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060009&flno=300"
        }
      ]
    },
    {
      "id": "U34-Q002",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依職業安全衛生設施規則，勞工八小時日時量平均音壓級超過多少分貝或暴露劑量超過百分之五十時，雇主應使勞工戴用有效之耳塞、耳罩等防音防護具？",
      "options": [
        {
          "id": "A",
          "text": "80分貝"
        },
        {
          "id": "B",
          "text": "85分貝"
        },
        {
          "id": "C",
          "text": "90分貝"
        },
        {
          "id": "D",
          "text": "100分貝"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職業安全衛生設施規則規定，對於勞工八小時日時量平均音壓級超過85分貝或暴露劑量超過百分之五十時，雇主應使勞工戴用有效之耳塞、耳罩等防音防護具。85分貝為佩戴防音防護具之基準，低於90分貝之工程控制基準。",
      "references": [
        {
          "title": "職業安全衛生設施規則第300條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060009&flno=300"
        }
      ]
    },
    {
      "id": "U34-Q003",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依職業安全衛生設施規則，任何時間勞工均不得暴露於峰值超過多少分貝之衝擊性噪音？",
      "options": [
        {
          "id": "A",
          "text": "100分貝"
        },
        {
          "id": "B",
          "text": "115分貝"
        },
        {
          "id": "C",
          "text": "140分貝"
        },
        {
          "id": "D",
          "text": "150分貝"
        }
      ],
      "answer": [
        "C"
      ],
      "explanation": "職業安全衛生設施規則規定，任何時間不得暴露於峰值超過140分貝之衝擊性噪音或115分貝之連續性噪音。衝擊性噪音之瞬間峰值極高，140分貝以上可能造成聽力永久損傷，故任何時間均不得暴露。",
      "references": [
        {
          "title": "職業安全衛生設施規則第300條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060009&flno=300"
        }
      ]
    },
    {
      "id": "U34-Q004",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依職業安全衛生設施規則，任何時間勞工均不得暴露於超過多少分貝之連續性噪音？",
      "options": [
