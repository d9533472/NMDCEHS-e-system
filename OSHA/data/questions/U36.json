    {
      "id": "U36-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生法第6條第2項，雇主對於下列何種危害應採取預防措施？",
      "options": [
        {
          "id": "A",
          "text": "僅噪音危害"
        },
        {
          "id": "B",
          "text": "重複作業等促發肌肉骨骼疾病之危害"
        },
        {
          "id": "C",
          "text": "僅化學性危害"
        },
        {
          "id": "D",
          "text": "僅火災爆炸危害"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職業安全衛生法第6條第2項第3款規定，雇主對於重複作業等促發肌肉骨骼疾病之危害，應採取必要之預防措施。人因性危害如重複動作、不良姿勢、過度施力等，可能导致肌肉骨骼疾病，雇主有法定預防義務。",
      "references": [
        {
          "title": "職業安全衛生法第6條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060001&flno=6"
        }
      ]
    },
