    {
      "id": "U26-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生法第10條規定，雇主對於危害性化學品之標示及通識，應依下列何者辦理？",
      "options": [
        {
          "id": "A",
          "text": "僅依雇主自訂標準"
        },
        {
          "id": "B",
          "text": "中央主管機關規定之標示及通識規則"
        },
        {
          "id": "C",
          "text": "僅依國際標準"
        },
        {
          "id": "D",
          "text": "僅依廠商建議"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職安法第10條第1項規定，雇主對於危害性化學品之標示及通識，應依中央主管機關規定之標示及通識規則辦理。即危害性化學品標示及通識規則。",
      "references": [
        {
          "title": "職業安全衛生法第10條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060001&flno=10"
        }
      ]
    },
