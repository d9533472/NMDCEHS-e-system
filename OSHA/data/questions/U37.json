  "questions": [
    {
      "id": "U37-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生法第6條第2項規定，雇主應妥為規劃及採取必要之安全衛生措施，下列何者屬於該條所列項目？",
      "options": [
        {
          "id": "A",
          "text": "輪班、夜間工作、長時間工作等異常工作負荷促發疾病之預防"
        },
        {
          "id": "B",
          "text": "產品品質管理"
        },
        {
          "id": "C",
          "text": "公司財務報表審計"
        },
        {
          "id": "D",
          "text": "員工旅遊活動規劃"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "職業安全衛生法第6條第2項第2款明定，雇主應妥為規劃及採取必要之安全衛生措施，包括「輪班、夜間工作、長時間工作等異常工作負荷促發疾病之預防」。此為防止過勞之法律依據。其他選項均非職安法規範範疇。",
      "references": [
        {
          "title": "職業安全衛生法第6條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060001&flno=6"
        }
      ]
    },
    {
      "id": "U37-Q002",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生設施規則第324條之2規定，雇主使勞工從事輪班、夜間工作、長時間工作等作業，為避免勞工因異常工作負荷促發疾病，應採取疾病預防措施。下列何者不屬於法定應採取之措施？",
