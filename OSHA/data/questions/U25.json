  "questions": [
    {
      "id": "U25-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生設施規則規定，雇主對於電氣設備裝設及作業，應依下列何者之規定辦理？",
      "options": [
        {
          "id": "A",
          "text": "僅依雇主自訂標準"
        },
        {
          "id": "B",
          "text": "電業法及電工技術法規"
        },
        {
          "id": "C",
          "text": "僅依國際電工標準"
        },
        {
          "id": "D",
          "text": "僅依廠商建議"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職業安全衛生設施規則第239條規定，雇主對於電氣設備之裝設、維護及操作，應依電業法及電工技術法規之規定辦理。電業法及電工技術法規為電氣安全之基本法規依據。",
      "references": [
        {
          "title": "職業安全衛生設施規則第239條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060009&flno=239"
        }
      ]
    },
    {
      "id": "U25-Q002",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依職業安全衛生設施規則規定，雇主對於勞工作業場所之照明設備，其照明燈具距離地面多少公尺以下者，不得使用額定電壓超過多少伏特之燈具？",
      "options": [
        {
          "id": "A",
          "text": "1.5公尺以下，不得超過110伏特"
        },
        {
          "id": "B",
          "text": "2公尺以下，不得超過220伏特"
        },
        {
          "id": "C",
          "text": "2.5公尺以下，不得超過24伏特"
        },
        {
          "id": "D",
          "text": "3公尺以下，不得超過36伏特"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職業安全衛生設施規則第249條規定，雇主對於勞工工作場所之照明燈具距離地面二公尺以下者，不得使用額定電壓超過220伏特之燈具。潮濕或有導電性灰塵場所，則不得超過24伏特。",
      "references": [
        {
          "title": "職業安全衛生設施規則第249條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060009&flno=249"
        }
      ]
    },
    {
      "id": "U25-Q003",
      "type": "single_choice",
      "difficulty": "advanced",
      "stem": "依職業安全衛生設施規則規定，雇主對於勞工於良導體機器設備內或鋼架上等導電性良好場所作業時，其使用之照明燈具額定電壓不得超過多少伏特？",
      "options": [
        {
          "id": "A",
          "text": "12伏特"
        },
        {
          "id": "B",
          "text": "24伏特"
        },
        {
          "id": "C",
          "text": "36伏特"
        },
        {
          "id": "D",
          "text": "110伏特"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職業安全衛生設施規則第249條第2項規定，雇主對於勞工於良導體機器設備內或鋼架上等導電性良好場所作業時，其使用之照明燈具額定電壓不得超過24伏特。因導電性良好場所感電危險性高，故採用安全特低電壓。",
      "references": [
        {
          "title": "職業安全衛生設施規則第249條",
