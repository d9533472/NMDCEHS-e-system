  "questions": [
    {
      "id": "U11-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生管理辦法第12條之2，實施職業安全衛生管理系統之事業單位，應參照什麼標準建置？",
      "options": [
        {
          "id": "A",
          "text": "ISO 9001"
        },
        {
          "id": "B",
          "text": "CNS 45001 國家標準"
        },
        {
          "id": "C",
          "text": "ISO 14001"
        },
        {
          "id": "D",
          "text": "ISO 27001"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "依第12條之2第1項，實施職安管理系統之事業單位，應參照中央主管機關公告之職業安全衛生管理系統指引（即CNS 45001國家標準）建置，或建立同等以上之職安管理系統。CNS 45001與ISO 45001內容一致。",
      "references": [
        {
          "title": "職業安全衛生管理辦法第12-2條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060027&flno=12-2"
        }
      ]
    },
    {
      "id": "U11-Q002",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "依職業安全衛生管理辦法第12條之2，下列何者非屬應實施職安管理系統之事業單位？",
      "options": [
        {
          "id": "A",
          "text": "第一類事業勞工人數200人以上"
        },
        {
          "id": "B",
          "text": "第二類事業勞工人數500人以上"
        },
        {
          "id": "C",
          "text": "石油裂解之石油化學工業"
        },
        {
          "id": "D",
          "text": "第一類事業勞工人數50人以上"
        }
      ],
      "answer": [
        "D"
      ],
      "explanation": "依第12條之2第1項第1款至第3款，應實施管理系統者為：(1)第一類事業勞工人數200人以上、(2)第二類事業勞工人數500人以上、(3)石油裂解之石油化學工業工作場所。D「50人以上」未達200人之門檻。",
      "references": [
        {
          "title": "職業安全衛生管理辦法第12-2條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060027&flno=12-2"
        }
      ]
    },
    {
