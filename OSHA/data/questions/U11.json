    {
      "id": "U11-Q011",
      "type": "single_choice",
      "difficulty": "intermediate",
      "stem": "ISO 45001:2018 中，第7條規定之內容為何？",
      "options": [
        {
          "id": "A",
          "text": "支援"
        },
        {
          "id": "B",
          "text": "營運"
        },
        {
          "id": "C",
          "text": "規劃"
