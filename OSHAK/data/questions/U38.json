  "questions": [
    {
      "id": "U38-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業安全衛生法第30條規定，雇主不得使妊娠中之女性勞工從事下列何種工作？",
      "options": [
        {
          "id": "A",
          "text": "礦坑工作"
        },
        {
          "id": "B",
          "text": "文書處理工作"
        },
        {
          "id": "C",
          "text": "一般行政工作"
        },
        {
          "id": "D",
          "text": "電話客服工作"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "職安法第30條第1項第1款明定，雇主不得使妊娠中之女性勞工從事礦坑工作。礦坑工作具有高度危險性，對妊娠中女性勞工及其胎兒健康均構成重大危害，故絕對禁止。",
      "references": [
        {
          "title": "職業安全衛生法第30條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0060001&flno=30"
        }
      ]
    },
