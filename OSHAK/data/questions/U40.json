    {
      "id": "U40-Q001",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業訓練法第31條規定，為提高技能水準，技能檢定由何機關辦理？",
      "options": [
        {
          "id": "A",
          "text": "中央主管機關"
        },
        {
          "id": "B",
          "text": "地方政府"
        },
        {
          "id": "C",
          "text": "民間機構"
        },
        {
          "id": "D",
          "text": "各事業單位自行辦理"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "職業訓練法第31條規定，為提高技能水準，促進技能發展與運用，技能檢定由「中央主管機關」辦理。中央主管機關即勞動部，負責全國技能檢定之規劃與執行。",
      "references": [
        {
          "title": "職業訓練法第31條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0080001&flno=31"
        }
      ]
    },
    {
      "id": "U40-Q002",
      "type": "single_choice",
      "difficulty": "basic",
      "stem": "依職業訓練法第33條規定，技能檢定分為幾級？",
      "options": [
        {
          "id": "A",
          "text": "甲、乙二級"
        },
        {
          "id": "B",
          "text": "甲、乙、丙三級"
        },
        {
          "id": "C",
          "text": "初、中、高三級"
        },
        {
          "id": "D",
          "text": "僅一級"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "職業訓練法第33條第1項規定，技能檢定分為「甲、乙、丙」三級。甲級為最高級，比照大學校院畢業程度；乙級比照專科學校畢業程度；丙級比照高級職業學校畢業程度。",
      "references": [
        {
          "title": "職業訓練法第33條",
          "url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=N0080001&flno=33"
        }
      ]
    },
